{
  "name": "wayfer-assesment",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@prisma/client": "^7.10.0",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "check-types": "bun run --cwd packages/db check-types && bun run --cwd apps/web check-types",
    "db:generate": "packages/db/node_modules/.bin/prisma generate --config packages/db/prisma.config.ts",
    "db:migrate": "bun --env-file=apps/web/.env packages/db/node_modules/prisma/build/index.js migrate deploy --config packages/db/prisma.config.ts",
    "db:seed": "bun --env-file=apps/web/.env packages/db/prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "bun run db:generate && bun run db:migrate && bun run db:seed",
    "test": "bun --env-file=apps/web/.env test tests"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wayfer-assesment/config": "workspace:*",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
